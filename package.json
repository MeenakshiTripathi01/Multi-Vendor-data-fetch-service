{
  "name": "multi-vendor-fetch-service",
  "version": "1.0.0",
  "description": "Multi-vendor data fetch service with Express, MongoDB, and RabbitMQ",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node worker/worker.js",
    "start:sync-vendor": "node vendor-mocks/sync-vendor.js",
    "start:async-vendor": "node vendor-mocks/async-vendor.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-timeout=30000 \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test --test-timeout=300000 --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:all": "node --test --test-timeout=300000 --test-concurrency=1 \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\""
  },
  "keywords": [
    "express",
    "mongodb",
    "rabbitmq"
  ],
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "express": "^5.3.0",
    "mongodb": "^6.20.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.3.0",
    "nodemon": "^3.1.14"
  }
}
