# Local development defaults. Copy to .env if you run processes on the host.
# These are not production secrets. Change WEBHOOK_SECRET before any real deployment.
# Do not commit a filled-in .env file.

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Inside Docker Compose the hostname is `mongo`, not localhost.
MONGO_URL=mongodb://mongo:27017/vendor_fetch?replicaSet=rs0
MONGO_DB=vendor_fetch
MONGO_CONNECT_RETRIES=30

# The RabbitMQ user is not `guest`. The guest account can only connect from
# inside the RabbitMQ container, so the app uses a dedicated dev user.
RABBITMQ_URL=amqp://vendor:vendor@rabbitmq:5672
RABBIT_CONNECT_RETRIES=30
JOBS_QUEUE=jobs

# Shared HMAC secret for the async vendor webhook. Example value only.
WEBHOOK_SECRET=dev-webhook-secret-change-me

SYNC_VENDOR_URL=http://sync-vendor:4001
ASYNC_VENDOR_URL=http://async-vendor:4002
ASYNC_WEBHOOK_URL=http://api:3000/vendor-webhook/async
SYNC_VENDOR_PORT=4001
ASYNC_VENDOR_PORT=4002

# Each vendor allows 2 requests in any rolling 1000ms window.
VENDOR_RATE_LIMIT=2
VENDOR_RATE_WINDOW_MS=1000
RATE_LIMIT_MAX_WAIT_MS=20000

WORKER_MAX_ATTEMPTS=5
WORKER_PREFETCH=1
WORKER_LEASE_MS=15000
RETRY_BASE_MS=1000
RETRY_CAP_MS=16000

SYNC_VENDOR_LATENCY_MS=0
SYNC_VENDOR_TIMEOUT_MS=2000
SYNC_VENDOR_TIMEOUT_DELAY_MS=10000
ASYNC_VENDOR_DELAY_MS=400
ASYNC_VENDOR_TIMEOUT_MS=2000

WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_BASE_MS=200
WEBHOOK_TIMEOUT_MS=2000

OUTBOX_INTERVAL_MS=500
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LOCK_MS=30000

# Comma-separated field names removed from vendor results.
PII_FIELDS=email,phone,ssn
